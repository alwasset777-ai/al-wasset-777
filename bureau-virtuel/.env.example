# Copiez ce fichier en « .env » et remplissez seulement ce que vous avez.
# Tout ce qui est vide = cette partie reste éteinte (le reste marche quand même).
# NE PUBLIEZ JAMAIS le fichier .env (il est déjà exclu de GitHub).

# ---------- Cerveau (IA) gratuit ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Secours sur votre ordinateur, sans internet (gratuit) : installez Ollama puis
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# ---------- Agents allumés (ajoutez-en un à la fois) ----------
# Choix : creatif, community, media_buyer, db_manager, auditor, rnd
AGENTS_ACTIFS=community,db_manager,auditor,rnd

# ---------- Routine quotidienne ----------
HEURE_ROUTINE=08:00
# Secondes pour voir les agents marcher à l'écran (0 = aucune pause)
RYTHME_ANIMATION=1.2
FUSEAU=Africa/Casablanca

# ---------- Telegram (rapport + boutons ✅/❌ sur le téléphone) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Base du site (Firebase) ----------
# Chemin du fichier JSON du « compte de service » (voir le guide). Vide = base de démo.
FIREBASE_CREDENTIALS=

# ---------- Meta (Facebook, Instagram, publicité) ----------
META_API_VERSION=v23.0
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=
# Vide = on utilise META_PAGE_TOKEN
META_ADS_TOKEN=
# Plafond de budget PAR JOUR (dans la devise du compte pub). L'IA ne peut jamais le dépasser.
BUDGET_MAX_JOUR=100
# Au-delà de ce coût par clic, le Media Buyer propose de mettre en pause
CPC_MAX=3
META_SPECIAL_CATEGORY=HOUSING
ZONE_LAT=33.8935
ZONE_LNG=-5.5473
ZONE_RAYON_KM=25

# ---------- GitHub (veille de l'Agent R&D, facultatif) ----------
GITHUB_TOKEN=

# ---------- Serveur ----------
# 127.0.0.1 = le bureau n'est visible que sur CET ordinateur (recommandé)
HOST=127.0.0.1
PORT=8000
