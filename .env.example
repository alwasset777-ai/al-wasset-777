# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Agent publicitaire IA (server.ts) — optionnel
# GEMINI_MODEL: modèle utilisé pour rédiger les publicités (défaut : gemini-2.5-flash)
# PORT: port du serveur unique (défaut : 3000 ; Cloud Run le fixe automatiquement)
GEMINI_MODEL="gemini-2.5-flash"

# ---- Firebase (registre en ligne + connexion du gérant) ----
# Valeurs visibles dans Firebase > Paramètres du projet > Vos applications (application Web).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_APP_ID=""
# Emails autorisés à publier / utiliser l'IA (séparés par des virgules). Obligatoire.
ADMIN_EMAILS=""

# ---- Meta (publication automatique Facebook + Instagram) — SECRETS, côté serveur uniquement ----
META_PAGE_ID=""
META_IG_USER_ID=""
META_PAGE_ACCESS_TOKEN=""
# META_GRAPH_VERSION="v21.0"
