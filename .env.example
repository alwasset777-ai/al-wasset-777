# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Agent publicitaire IA (server.ts) — optionnel
# GEMINI_MODEL: modèle utilisé pour rédiger les publicités (défaut : gemini-2.5-flash)
# PORT: port du serveur unique (défaut : 3000 ; Cloud Run le fixe automatiquement)
GEMINI_MODEL="gemini-2.5-flash"

# ---- Firebase (registre en ligne + connexion du gérant) ----
# Valeurs visibles dans Firebase > Paramètres du projet > Vos applications (application Web).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_APP_ID=""
# Emails autorisés à publier / utiliser l'IA (séparés par des virgules). Obligatoire.
ADMIN_EMAILS=""

# ---- Meta (publication automatique Facebook + Instagram) — SECRETS, côté serveur uniquement ----
META_PAGE_ID=""
META_IG_USER_ID=""
META_PAGE_ACCESS_TOKEN=""
# META_GRAPH_VERSION="v21.0"

# ---- وكيل الوسيط 777 (avatar, WhatsApp, rappels) — SECRETS, côté serveur uniquement ----
# Compte de service Firebase (contenu JSON) : WhatsApp, tâches et rappels gardés dans Firestore.
FIREBASE_SERVICE_ACCOUNT=""
# WhatsApp Business Platform (API Cloud de Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Mot de passe choisi librement, recopié dans Meta (vérification du webhook)
WHATSAPP_VERIFY_TOKEN=""
# Clé secrète de l'application Meta (Paramètres > Général) : vérifie que les messages viennent de Meta
WHATSAPP_APP_SECRET=""
# Numéros du gérant qui donnent des ordres à l'agent (ex. 212777777959), séparés par des virgules
WHATSAPP_OWNER_NUMBERS=""
# Clé des rappels automatiques et du rapport du matin : /api/cron/tick?key=CRON_SECRET
CRON_SECRET=""
