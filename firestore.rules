rules_version = '2';
// Seuls les comptes du gérant (liste ci-dessous) peuvent lire et modifier le registre.
// Remplacez l'adresse par l'email du compte créé dans Firebase > Authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['REMPLACER_PAR_VOTRE_EMAIL@exemple.com'];
    }
    match /registry/{id} {
      allow read, write: if isAdmin();
    }
    // Demandes des clients du site : tout visiteur peut en créer une (champs limités),
    // seul le gérant peut les lire ou les supprimer.
    match /inbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'name', 'phone', 'message', 'propertyId', 'propertyTitle', 'preferredAt', 'createdAt'])
        && request.resource.data.kind in ['visite', 'rappel', 'recherche']
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000;
      allow read, delete: if isAdmin();
    }
    // وكيل الوسيط 777 : clients, rendez-vous, réglages / mémoire / conversation de l'agent.
    match /clients/{id} {
      allow read, write: if isAdmin();
    }
    match /appointments/{id} {
      allow read, write: if isAdmin();
    }
    match /agent_state/{key} {
      allow read, write: if isAdmin();
    }
    // wa_threads et agent_tasks : écrits et lus uniquement par le serveur (compte de service).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
