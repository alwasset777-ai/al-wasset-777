{
  "name": "wakil",
  "private": true,
  "version": "0.1.0",
  "description": "Wakil — agent IA autonome multiplateforme (web/PWA, Android/Huawei, Mac)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "vite build --mode native",
    "preview": "vite preview --port 4173",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run build:native && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "lucide-react": "0.546.0",
    "marked": "18.1.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.14.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vercel/node": "5.5.0",
    "@vitejs/plugin-react": "5.0.4",
    "fake-indexeddb": "6.2.7",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
